  "relationshipRules": [
    {
      "family": "Generalization:",
      "nativeCandidate": "Specialization",
      "gate": "needs_typed_endpoints_and_direction",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Aggregation:",
      "nativeCandidate": "OwnedPartUsage",
      "gate": "needs_composite_end_and_multiplicity",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Abstraction:allocate",
      "nativeCandidate": "Allocation",
      "gate": "needs_semantic_roles",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Dependency:satisfy",
      "nativeCandidate": "SatisfyRequirementUsage",
      "gate": "needs_requirement_objective",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Dependency:verify",
      "nativeCandidate": "VerifyRequirementUsage",
      "gate": "needs_verification_case_objective",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Dependency:deriveReqt",
      "nativeCandidate": "RequirementDerivation",
      "gate": "needs_two_requirements",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "UseCase:include",
      "nativeCandidate": "UseCaseInclusion",
      "gate": "needs_valid_ownership",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "UseCase:extend",
      "nativeCandidate": "UseCaseExtension",
      "gate": "needs_valid_extension",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "ControlFlow:",
      "nativeCandidate": "Succession",
      "gate": "needs_action_occurrences",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "StateFlow:",
      "nativeCandidate": "TransitionUsage",
      "gate": "needs_state_context",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Association:",
      "nativeCandidate": "ConnectionOrReference",
      "gate": "needs_connection_kind",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "Connector:",
      "nativeCandidate": "None",
      "gate": "evidence_only",
      "emission": "deferred_pending_evidence_and_parser"
    },
    {
      "family": "NoteLink:",
      "nativeCandidate": "None",
      "gate": "evidence_only",
      "emission": "deferred_pending_evidence_and_parser"
    }
  ],
  "workbenchContract": {
    "views": [
      "structure",
      "visual",
      "behavior",
      "requirements"
    ],
    "mustPreserveDistinctKinds": true,
    "selection": "note and element identities distinct",
    "validation": "no native writes on deferred or unparsed syntax",
    "navigation": [
      "containment",
      "connection",
      "inbound",
      "outbound",
      "source provenance"
    ],
    "roundTrip": "source evidence and user-authored text retained; no silent rewriting"
  },
  "deferredDecisions": [
    "redefinition mapping",
    "full-port ownership versus proxy-port contract repair",
    "binding port semantics",
    "state/action nested usages",
    "causal versus temporal behavior",
    "trade-study calculations and results"
  ],
  "noSilentDiscard": true
}
