  "version": "0.1.0",
  "authority": "approved_design_decisions_plus_provisional_source_families",
  "releaseStatus": "candidate_not_parser_verified",
  "defaultDisposition": "deferred_review",
  "automaticNativeEmission": false,
  "sourceRoles": "EA source/target stored independently from oriented SysML candidate",
  "provenance": [
    "source_guid",
    "source_pk",
    "ea_type",
    "ea_stereotype",
    "normalization_rule_id",
    "evidence_ids"
  ],
