{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["ES2020", "DOM"],
    "types": ["node"], "allowImportingTsExtensions": false, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
